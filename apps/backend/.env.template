# Copy to .env before running the backend:
#
#   cp apps/backend/.env.template apps/backend/.env
#
# The live values below are the native ones: Medusa runs on the host against a
# Postgres on the host. Native is the default local mode (D-017). Where a value
# differs in Codespaces, the Codespaces variant is labelled on the variable.

MEDUSA_ADMIN_ONBOARDING_TYPE=default

# native: your own Postgres on the host. With a localhost host Medusa stops
# force-enabling SSL, so the whole problem behind E-001 disappears on its own.
# See D-017.
#
# codespaces: the host is the compose service name `postgres`, and
# sslmode=disable is required -- Medusa infers SSL from this URL and
# force-enables it for any host that is not localhost/127.0.0.1, but
# postgres:16-alpine serves no SSL. You do not set it here:
# .devcontainer/docker-compose.yml exports DATABASE_URL and loadEnv will not
# override an env var that is already set, so this file's value is ignored
# inside the container. medusa-config.ts also sets databaseDriverOptions
# explicitly, for the same reason.
#
#   codespaces: postgres://centravy:centravy@postgres:5432/centravy?sslmode=disable
DATABASE_URL=postgres://centravy:centravy@localhost:5434/centravy

# No REDIS_URL, in either mode. medusa-config.ts sets no projectConfig.redisUrl,
# so Medusa logs `redisUrl not found` and falls back to in-memory caching,
# events and locking -- it never reads the variable. Deliberate; don't add it
# back. See D-006.

# Stays commented on purpose. Do not uncomment it as an oversight.
#
# native: uncomment it. PORT is read by the Medusa CLI, and 9009 exists because
#   a TLS-inspecting proxy may intercept host port 9000 and answer a zero-byte
#   200. See E-004.
# codespaces: leave it commented. The container must listen on 9000 -- that is
#   the port docker-compose publishes and devcontainer.json forwards -- and
#   postCreateCommand copies this file to .env, so a value here would move the
#   server off the forwarded port and make the admin unreachable.
#
#   PORT=9009

# Only used as the default when running `medusa db:create`. Natively you create
# the database yourself; in Codespaces the compose stack already creates it. So
# that command is not normally needed in either mode.
DB_NAME=centravy

# Set to "true" only for a managed database that requires TLS (Railway).
# Leave unset in both local modes: neither Postgres serves SSL. See E-001.
DATABASE_SSL=

# Entries wrapped in slashes are parsed as regular expressions. The github.dev
# one allows any GitHub Codespaces forwarded port, so the admin at /app stays
# reachable after the codespace is renamed or rebuilt. Drop it when deploying
# somewhere that is not Codespaces.
STORE_CORS=http://localhost:8000,https://docs.medusajs.com,/https:\/\/.*\.app\.github\.dev/
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com,/https:\/\/.*\.app\.github\.dev/
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,https://docs.medusajs.com,/https:\/\/.*\.app\.github\.dev/

# --- Secrets -----------------------------------------------------------------
# These are throwaway local defaults. Generate real ones before exposing this
# anywhere: openssl rand -hex 32
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=
