# Copy to .env before running the backend:
#
#   cp apps/backend/.env.template apps/backend/.env
#
# The non-secret values match .devcontainer/docker-compose.yml and work as-is.

MEDUSA_ADMIN_ONBOARDING_TYPE=default

# Hosts are the compose service names, reachable from the app container.
#
# sslmode=disable is required. Medusa infers SSL from this URL and force-enables
# it for any host that is not localhost/127.0.0.1, but postgres:16-alpine serves
# no SSL. medusa-config.ts also sets databaseDriverOptions explicitly, because
# the devcontainer exports DATABASE_URL and dotenv will not override an env var
# that is already set -- so this file's value is ignored inside the container.
DATABASE_URL=postgres://centravy:centravy@postgres:5432/centravy?sslmode=disable
REDIS_URL=redis://redis:6379

# Only used as the default when running `medusa db:create`. The compose stack
# already creates this database, so that command is not normally needed.
DB_NAME=centravy

# Set to "true" only for a managed database that requires TLS (Railway).
# Leave unset in the devcontainer: local Postgres serves no SSL. See D-004.
DATABASE_SSL=

# Entries wrapped in slashes are parsed as regular expressions. The github.dev
# one allows any GitHub Codespaces forwarded port, so the admin at /app stays
# reachable after the codespace is renamed or rebuilt. Drop it when deploying
# somewhere that is not Codespaces.
STORE_CORS=http://localhost:8000,https://docs.medusajs.com,/https:\/\/.*\.app\.github\.dev/
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com,/https:\/\/.*\.app\.github\.dev/
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:8000,https://docs.medusajs.com,/https:\/\/.*\.app\.github\.dev/

# --- Secrets -----------------------------------------------------------------
# These are throwaway local defaults. Generate real ones before exposing this
# anywhere: openssl rand -hex 32
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
AUTH_MFA_ENCRYPTION_KEY=
